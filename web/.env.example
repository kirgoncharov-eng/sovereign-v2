# Ключи моделей (нужен хотя бы один; при ошибке основной модели используется MODEL_FALLBACK через Anthropic)
GOOGLE_AI_KEY=
ANTHROPIC_API_KEY=

# Модели: FAST — события и последствия, DEEP — финальный вердикт
MODEL_FAST=gemini-3.1-flash-lite
MODEL_DEEP=gemini-3.1-flash-lite
MODEL_FALLBACK=claude-haiku-4-5-20251001

# Лимиты запросов к /api/ai на один IP (одна партия ≈ 42 запроса)
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=400

# 1 — отвечать заглушками без обращения к моделям (для разработки UI)
AI_MOCK=

# Ссылка в тексте «Поделиться итогом» (например, https://t.me/your_bot/app); по умолчанию — адрес сайта
NEXT_PUBLIC_SHARE_URL=

# Таблица «Дела дня» и подписчики бота: Redis по REST (Upstash или Vercel KV).
# Без них таблица работает в памяти процесса — только для разработки.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram-бот: токен от BotFather, секрет вебхука, адрес игры для кнопки
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
APP_URL=

# Секрет для утренней рассылки (Vercel Cron передаёт его сам)
CRON_SECRET=
